  {
    "id": "close-buffer",
    "category": "Files",
    "action": "Close buffer in current split",
    "keys": "Space b d",
    "context": "Normal",
    "notes": "Runs WinBufClose; keeps the buffer open in other splits that track it."
  },
  {
    "id": "join-lines",
    "category": "Files",
    "action": "Join lines",
    "keys": "Shift+J",
    "context": "Normal / Visual",
    "notes": "Normal: joins current and next line; Visual: joins selected lines. Removes leading indentation and adds spacing."
  },
  {
    "id": "omp-plan-preview",
    "category": "View",
    "action": "Show live agent plan",
    "keys": "Cmd+Shift+O",
    "context": "Rex; focus a Codex, OMP, or Claude Code agent pane",
    "notes": "Opens or reuses a right-side read-only plan copy in your terminal VISUAL/EDITOR with its normal config/plugins; falls back to Neovim/vi. Keeps agent focus. Vim/Neovim automatically reload saved plan updates; other editors control reloads. Source plans are never edited. q closes Vim/Neovim. Close an old graphics pane before reopening. No Pandoc/Typst needed."
  },
  {
    "id": "search-shortcuts",
    "category": "Reference",
    "action": "Search Neovim shortcuts",
    "keys": "Space ?",
    "context": "Normal mode",
    "notes": "Press sequentially; Space alone shows hints after 300 ms"
  },
  {
    "id": "equalize-splits",
